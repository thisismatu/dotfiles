# Mac like keyboard bindings for mac keyboard

# Place in /etc/keyd/default.conf
# Inspired by https://github.com/omacom/omarchy/discussions/175

[ids]
*

[main]
# Cmd keys trigger the cmd layer
leftmeta = layer(cmd)
rightmeta = layer(cmd)

[alt]
# Disable alt+tab
tab = noop

[alt:C]
# Option text navigation
right = C-right
left = C-left
backspace = C-backspace

[cmd:C]
# Essential shortcuts
a = C-a          # Select all
c = C-c          # Copy
v = C-v          # Paste
x = C-x          # Cut
z = C-z          # Undo
s = C-s          # Save
f = C-f          # Find
w = C-w          # Close tab
t = C-t          # New tab
q = C-q          # Quit

# Switch directly to an open tab (e.g. Firefox, VS code)
1 = A-1
2 = A-2
3 = A-3
4 = A-4
5 = A-5
6 = A-6
7 = A-7
8 = A-8
9 = A-9

[cmd]
# Text navigation
left = home
right = end
up = pageup
down = pagedown

# As soon as tab is pressed (but not yet released), we switch to the
# "app_switch_state" overlay where we can handle Meta-Backtick differently.
# Also, send a 'M-tab' key tap before entering app_switch_sate.
tab = swapm(app_switch_state, M-tab)

# Switch to next window in the application group using default binding (alt+f6)
` = A-f6

# app_switch_state modifier layer; inherits from 'Meta' modifier layer
[app_switch_state:M]

# Switch to next application
tab = M-tab
right = M-tab

# Switch to previous application
` = M-S-tab
left = M-S-tab

[control+alt]
# Window resizing using default bindings (super+<direction>)
up = M-up
down = M-down
left = M-left
right = M-right

# Workspaces using custom bindings (change in settings to shift+super+<direction>)
S-up = M-S-up
S-down = M-S-down
S-left = M-S-left
S-right = M-S-right
