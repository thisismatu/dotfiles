# Mac like keyboard bindings for mac keyboard

# Place in /etc/keyd/default.conf
# Inspired by https://github.com/omacom/omarchy/discussions/175

[ids]
*

[main]
# Cmd keys trigger the cmd layer
leftmeta = layer(cmd)
rightmeta = layer(cmd)

[alt]
# Disable alt+tab
tab = noop

[alt:C]
# Mac-like option text navigation
right = C-right
left = C-left
backspace = C-backspace

[cmd:C]
# Essential shortcuts
a = C-a          # Select all
c = C-c          # Copy
v = C-v          # Paste
x = C-x          # Cut
z = C-z          # Undo
s = C-s          # Save
f = C-f          # Find
w = C-w          # Close tab
t = C-t          # New tab
q = C-q          # Quit

# Switch directly to an open tab (e.g. Firefox, VS code)
1 = A-1
2 = A-2
3 = A-3
4 = A-4
5 = A-5
6 = A-6
7 = A-7
8 = A-8
9 = A-9

[cmd]
# Text navigation and selection (Mac-like)
left = home
right = end
# up = pageup
# down = pagedown
shift+left = S-home
shift+right = S-end
# shift+up = S-pageup
# shift+down = S-pagedown

# As soon as tab is pressed (but not yet released), we switch to the
# "app_switch_state" overlay where we can handle Meta-Backtick differently.
# Also, send a 'M-tab' key tap before entering app_switch_sate.
tab = swapm(app_switch_state, M-tab)

# Switch to next window in the application group
# - A-f6 is the default binding for 'cycle-group' in gnome
# - keybinding: `gsettings get org.gnome.desktop.wm.keybindings cycle-group`
` = A-f6

# app_switch_state modifier layer; inherits from 'Meta' modifier layer
[app_switch_state:M]

# Switch to next application
tab = M-tab
right = M-tab

# Switch to previous application
` = M-S-tab
left = M-S-tab

[control+alt]
# Window resizing (default keybindings)
up = M-up		# Fullscreen
down = M-down		# Tile left
left = M-left		# Tile left
right = M-right		# Restore

# Workspaces (change keybindings in settings)
S-up = M-S-up
S-down = M-S-down
S-left = M-S-left
S-right = M-S-right
