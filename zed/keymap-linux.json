// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "shift-alt-up": "editor::DuplicateLineUp",
      "shift-alt-down": "editor::DuplicateLineDown",
      "ctrl-alt-home": [
        "editor::AddSelectionAbove",
        {
          "skip_soft_wrap": true,
        },
      ],
      "ctrl-alt-end": [
        "editor::AddSelectionBelow",
        {
          "skip_soft_wrap": true,
        },
      ],
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "tab_switcher::Toggle",
      "ctrl-r": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "super--": "pane::GoBack",
      "super-=": "pane::GoForward",
      "ctrl-tab": "pane::ActivateNextItem",
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "super-ctrl-t": "pane::CloseOtherItems",
    },
  },
  {
    "bindings": {
      // Disable collabl panel
      "ctrl-shift-c": null,
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      // Disable close active dock
      "ctrl-w": null,
    },
  },
]
