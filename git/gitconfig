# ~/.gitconfig

[user]
    name = Mathias Herler
    email = mathias.lindholm@gmail.com
[credential]
    helper =                                                      # Reset
    helper = osxkeychain                                          # macOS default
    # helper = /usr/local/share/gcm-core/git-credential-manager   # install via brew/port
    # helper = libsecret                                          # Linux, install git-credential-libsecret
[credential "https://github.com"]
    username = thisismatu
[push]
    followTags = true
[pull]
    rebase = false
[rebase]
    autostash = true
[init]
    defaultBranch = main
[color]
    ui = true
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    required = true
    process = git-lfs filter-process
[alias]
    lg = log --graph --oneline --decorate --all
    wipe = !git add -A && git commit -qnm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
    ignore = "!ignore() { curl -L -s https://www.toptal.com/developers/gitignore/api/$@ ;}; ignore"
    cleanup = "!git branch --merged main --format='%(refname:short)' | grep -vx main | xargs git branch -d"

# Work
[includeIf "gitdir:~/Sites/cambri/"]
    path = ~/Sites/cambri/.gitconfig
